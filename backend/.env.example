# Database (use sqlite for zero-setup local, or postgres via docker-compose)
DATABASE_URL=sqlite:///./ai_consultant.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_consultant

# Encryption key for stored secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# Gemini
GEMINI_API_KEY=your_google_gemini_key
DEFAULT_CHAT_MODEL=gemini-2.5-pro
DEFAULT_CODING_MODEL=gemini-2.5-pro

# Server
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Workspace root for cloned repos (used by the implementation agent)
WORKSPACE_ROOT=./workspaces
